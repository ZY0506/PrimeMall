syntax = "v1"

info(
    title: "PrimeMall-订单服务"
    desc: "负责购物车、下单流程、订单管理、物流追踪及售后处理"
    author: "烤冷面"
    version: "v1.0"
)

// =============================================================
// 1. 公共类型定义
// =============================================================

type (
    // 批量 SKU ID 请求（用于删除购物车、批量查询等）
    BatchSkuReq {
        SkuIds []int64 `json:"sku_ids"`
    }

        // 通用 ID 请求
    IdReq {
        Id int64 `path:"id"`
    }

        // 订单号路径参数
    OrderSnReq {
        OrderSn string `path:"order_sn"`
    }
)

// =============================================================
// 2. 购物车模块数据结构
// =============================================================

type (
    // 购物车项（实时数据）
    CartItem {
        Id          int64  `json:"id,optional"`   // 购物车记录ID
        SkuId       int64  `json:"sku_id"`
        SpuId       int64  `json:"spu_id"`        // SPU ID
        ProductName string `json:"product_name"`  // 商品名称
        SkuName     string `json:"sku_name"`      // 规格名称
        Pic         string `json:"pic"`           // 商品图片
        Price       int64  `json:"price"`         // **实时单价**（字符串，避免精度丢失）
        Quantity    int64  `json:"quantity"`
        Selected    bool   `json:"selected"`      // 是否勾选
        Stock       int64  `json:"stock"`         // 实时库存
        Status      int64  `json:"status"`        // 商品状态 1:正常 2:下架/失效
    }

    CartListResp {
        Items       []CartItem `json:"items"`
        TotalAmount string     `json:"total_amount"` // 勾选商品总金额
    }

    UpdateCartReq {
        SkuId    int64 `json:"sku_id"`
        Quantity int64 `json:"quantity"` // 数量，若为0则从购物车移除
    }

    SelectCartReq {
        SkuId    int64 `json:"sku_id"`
        Selected bool  `json:"selected"`
    }
)

// =============================================================
// 3. 订单相关数据结构
// =============================================================

type (
    // 下单商品项（前端传入）
    OrderItemReq {
        SkuId    int64 `json:"sku_id"`
        Quantity int64 `json:"quantity"`
    }

        // 结算令牌（预下单返回）
    SettlementTokenResp {
        Token      string `json:"settlement_token"` // 结算令牌，有效期 5 分钟
        ExpireTime int64  `json:"expire_time"`      // 过期时间戳（秒）
    }

        // 预下单请求（确认订单页）
    PreOrderReq {
        Items     []OrderItemReq `json:"items"`
        AddressId int64          `json:"address_id,optional"`
        CouponId  int64          `json:"coupon_id,optional"`
    }

        // 地址快照
    AddressSnapshot {
        ReceiverName  string `json:"receiver_name"`
        ReceiverPhone string `json:"receiver_phone"`
        Province      string `json:"province"`
        City          string `json:"city"`
        District      string `json:"district"`
        DetailAddress string `json:"detail_address"`
    }

        // 预下单响应（展示金额明细）
    PreOrderResp {
        Token         string           `json:"settlement_token"`
        Items         []CartItem       `json:"items"`          // 商品清单（实时价格）
        Address       AddressSnapshot  `json:"address"`        // 地址详情
        TotalAmount   string           `json:"total_amount"`   // 商品总价
        FreightAmount string           `json:"freight_amount"` // 运费
        CouponAmount  string           `json:"coupon_amount"`  // 优惠券减免
        PayAmount     string           `json:"pay_amount"`     // 实际支付金额
    }

        // 正式创建订单请求
    CreateOrderReq {
        SettlementToken string `json:"settlement_token"` // 结算令牌，必填
        AddressId       int64  `json:"address_id"`       // 最终使用的地址ID
        CouponId        int64  `json:"coupon_id,optional"`
        PayType         int64  `json:"pay_type,optional"`   // 支付方式
        PayAmount       int64  `json:"pay_amount"`          // 前端传回的应付金额，用于后端二次校验
        Remark          string `json:"remark,optional"`
        IdempotencyKey  string `json:"idempotency_key"` // 幂等键（前端生成）
    }

    CreateOrderResp {
        OrderSn   string `json:"order_sn"`
        PayAmount string `json:"pay_amount"`
    }

        // 订单商品快照（用于订单列表/详情）
    OrderItemSnapshot {
        SkuId       int64  `json:"sku_id"`
        SpuId       int64  `json:"spu_id"`
        ProductName string `json:"product_name"`
        SkuName     string `json:"sku_name"`
        Pic         string `json:"pic"`
        Price       string `json:"price"`   // 下单时单价
        Quantity    int64  `json:"quantity"`
        TotalAmount string `json:"total_amount"`
    }

        // 订单列表项
    OrderListItem {
        OrderSn     string               `json:"order_sn"`
        Status      int64                `json:"status"`       // 10:待付款 20:待发货 30:待收货 40:已完成 50:已取消 60:售后中
        StatusDesc  string               `json:"status_desc"`
        PayAmount   string               `json:"pay_amount"`
        CreateTime  string               `json:"create_time"`  // RFC3339 格式
        Items       []OrderItemSnapshot  `json:"items"`
    }

    OrderListReq {
        Status int64 `form:"status,default=0"` // 0:全部 10,20,30,40,50,60
        Page   int64 `form:"page,default=1"`
        Size   int64 `form:"size,default=10"`
    }

    OrderListResp {
        Total int64           `json:"total"`
        List  []OrderListItem `json:"list"`
    }

        // 订单详情
    OrderDetailResp {
        OrderListItem                          // 继承订单列表项
        Address          AddressSnapshot `json:"address"`           // 收货地址快照
        FreightAmount    string           `json:"freight_amount"`
        CouponAmount     string           `json:"coupon_amount"`
        DeliverySn       string           `json:"delivery_sn,optional"`
        DeliveryCorp     string           `json:"delivery_corp,optional"`
        ExpireTime       int64            `json:"expire_time,optional"` // 待付款倒计时截止时间戳
        Remark           string           `json:"remark,optional"`
    }

        // 取消订单请求
    CancelOrderReq {
        CancelReason string `json:"cancel_reason,optional"`
    }
)

// =============================================================
// 4. 物流相关数据结构
// =============================================================

type (
    // 物流轨迹节点
    DeliveryTrackItem {
        Time        string `json:"time"`         // 时间 RFC3339
        Station     string `json:"station"`      // 地点
        Status      string `json:"status"`       // 状态描述，如“已揽收”“运输中”
        Description string `json:"description"`  // 详细说明
    }

    DeliveryTrackResp {
        OrderSn      string               `json:"order_sn"`
        DeliverySn   string               `json:"delivery_sn"`
        DeliveryCorp string               `json:"delivery_corp"`
        Status       int64                `json:"status"`        // 物流主状态码
        StatusDesc   string               `json:"status_desc"`   // 状态描述（已揽收/运输中/派送中/已签收）
        Tracks       []DeliveryTrackItem  `json:"tracks"`
    }
)

// =============================================================
// 5. 售后相关数据结构
// =============================================================

type (
    AfterSaleReq {
        OrderSn     string   `json:"order_sn"`
        SkuId       int64    `json:"sku_id"`
        Quantity    int64    `json:"quantity"`           // 退款数量（支持部分退款）
        Type        int64    `json:"type"`               // 1:仅退款 2:退货退款
        Reason      string   `json:"reason"`
        ApplyAmount string   `json:"apply_amount"`       // 申请退款金额
        Images      []string `json:"images,optional"`
    }

    AfterSaleResp {
        AfterSaleId  int64  `json:"after_sale_id"`
        Status       int64  `json:"status"`        // 1:待审核 2:待退货 3:退款中 4:已完成 5:已拒绝
        StatusDesc   string `json:"status_desc"`
        ApplyAmount  string `json:"apply_amount"`
        AuditRemark  string `json:"audit_remark,omitempty"`
        CreatedAt    string `json:"created_at"`
    }
)

// =============================================================
// 6. 服务接口定义
// =============================================================

// --- 购物车模块 ---
@server(
    jwt:    JwtAuth
    group:  cart
    prefix: api/v1/order/cart
)
service shop-api {
    @doc "添加/更新购物车商品（数量为0则删除）"
    @handler updateCart
    post /update (UpdateCartReq) returns ()

    @doc "修改购物车商品的勾选状态"
    @handler selectCart
    post /select (SelectCartReq) returns ()

    @doc "获取购物车列表"
    @handler cartList
    get /list returns (CartListResp)

    @doc "批量删除购物车商品"
    @handler removeCart
    delete /remove (BatchSkuReq) returns ()

    @doc "清空购物车"
    @handler clearCart
    delete /clear returns ()
}

// --- 订单核心模块 ---
@server(
    jwt:    JwtAuth
    group:  order
    prefix: api/v1/order
)
service shop-api {
    @doc "预下单（确认订单页，生成结算令牌）"
    @handler preOrder
    post /pre-order (PreOrderReq) returns (PreOrderResp)

    @doc "正式提交订单（需携带结算令牌）"
    @handler createOrder
    post /create (CreateOrderReq) returns (CreateOrderResp)

    @doc "订单列表"
    @handler orderList
    get /list (OrderListReq) returns (OrderListResp)

    @doc "订单详情"
    @handler orderDetail
    get /detail/:order_sn (OrderSnReq) returns (OrderDetailResp)

    @doc "取消订单（仅待支付状态可取消）"
    @handler cancelOrder
    post /cancel/:order_sn (CancelOrderReq) returns ()

    @doc "确认收货"
    @handler confirmReceipt
    post /confirm/:order_sn (OrderSnReq) returns ()
}

// --- 物流模块 ---
@server(
    jwt:    JwtAuth
    group:  delivery
    prefix: api/v1/order/delivery
)
service shop-api {
    @doc "查询物流轨迹"
    @handler track
    get /track/:order_sn (OrderSnReq) returns (DeliveryTrackResp)
}

// --- 售后模块 ---
@server(
    jwt:    JwtAuth
    group:  aftersale
    prefix: api/v1/order/aftersale
)
service shop-api {
    @doc "申请售后"
    @handler applyAfterSale
    post /apply (AfterSaleReq) returns (AfterSaleResp)

    @doc "查询售后详情"
    @handler afterSaleDetail
    get /detail/:id (IdReq) returns (AfterSaleResp)

    @doc "取消售后申请（仅待审核状态可取消）"
    @handler cancelAfterSale
    post /cancel/:id (IdReq) returns ()
}