syntax = "v1"

info(
    title: "PrimeMall-营销服务"
    desc: "负责优惠券的展示、领取、个人资产管理。注：秒杀业务计划在第二阶段实施。"
    author: "烤冷面"
    version: "v1.0"
)

// =============================================================
// 1. 数据结构定义
// =============================================================

type (
    // 优惠券基础信息
    Coupon {
        Id                int64  `json:"id"`
        Name              string `json:"name"`
        Type              int64  `json:"type"`                 // 1-满减券，2-折扣券，3-无门槛券
        ThresholdAmount   int64  `json:"threshold_amount"`     // 使用门槛（分）
        ReduceAmount      int64  `json:"reduce_amount"`        // 满减金额（分），仅满减券有效
        DiscountRate      int64  `json:"discount_rate"`        // 折扣率：80 表示 8 折，仅折扣券有效
        MaxDiscountAmount int64  `json:"max_discount_amount"`  // 折扣封顶金额（分），仅折扣券有效
        StartTime         string `json:"start_time"`           // 活动生效开始时间 RFC3339
        EndTime           string `json:"end_time"`             // 活动生效结束时间 RFC3339
        Description       string `json:"description"`
        IsClaimed         bool   `json:"is_claimed"`           // 当前用户是否已领取（领券中心专用）
    }

        // 用户优惠券资产（我的卡包）
    UserCoupon {
        Id               int64  `json:"id"`                    // 用户优惠券记录ID
        CouponId         int64  `json:"coupon_id"`
        Name             string `json:"name"`
        Type             int64  `json:"type"`
        Status           int64  `json:"status"`                // 0-未使用，1-已使用，2-已过期
        ExpireTime       string `json:"expire_time"`           // 用户持有过期时间 RFC3339
        OrderSn          string `json:"order_sn,optional"`     // 使用该券的订单号
        UnavailableReason string `json:"unavailable_reason,optional"` // 不可用原因（结算页用）
        // 快照信息（避免优惠券规则修改影响历史订单）
        ThresholdAmount  int64  `json:"threshold_amount"`
        ReduceAmount     int64  `json:"reduce_amount"`
        DiscountRate     int64  `json:"discount_rate"`
        MaxDiscountAmount int64 `json:"max_discount_amount"`
    }
)

type (
    // 领券中心列表请求
    CouponListReq {
        Page int64 `form:"page,default=1"`
        Size int64 `form:"size,default=10"`
    }

    CouponListResp {
        Total int64    `json:"total"`
        List  []Coupon `json:"list"`
    }

        // 领取优惠券请求
    ClaimCouponReq {
        CouponId int64 `json:"coupon_id"`
    }

        // 领取优惠券响应
    ClaimCouponResp {
        UserCouponId int64  `json:"user_coupon_id"`
        ExpireTime   string `json:"expire_time"` // 领取后的过期时间
    }

        // 我的优惠券列表请求
    MyCouponListReq {
        Status int64 `form:"status,default=0"` // 0-未使用，1-已使用，2-已过期
        Page   int64 `form:"page,default=1"`
        Size   int64 `form:"size,default=10"`
    }

    MyCouponListResp {
        Total int64        `json:"total"`
        List  []UserCoupon `json:"list"`
    }
)

type (
    // 结算页可用优惠券查询（暂不支持按商品过滤）
    AvailableCouponsReq {
        OrderAmount int64 `json:"order_amount"` // 当前订单总金额（分）
    }

    AvailableCouponsResp {
        Available   []UserCoupon `json:"available"`   // 可使用的优惠券
        Unavailable []UserCoupon `json:"unavailable"` // 不可使用的优惠券（含原因）
    }
)

// =============================================================
// 2. 内部使用接口（供订单服务调用，需特殊鉴权）
// =============================================================

type (
    // 使用优惠券请求（订单创建时锁定）
    UseCouponReq {
        UserCouponId int64  `json:"user_coupon_id"`
        OrderSn      string `json:"order_sn"`
    }

    UseCouponResp {
        Success      bool   `json:"success"`
        DiscountAmount int64 `json:"discount_amount"` // 实际减免金额（分）
        ErrorMsg     string `json:"error_msg,optional"`
    }

        // 解锁/回滚优惠券（订单取消时）
    UnlockCouponReq {
        UserCouponId int64  `json:"user_coupon_id"`
        OrderSn      string `json:"order_sn"`
    }

    UnlockCouponResp {
        Success  bool   `json:"success"`
        ErrorMsg string `json:"error_msg,optional"`
    }
)

// =============================================================
// 3. 服务接口定义
// =============================================================

// --- C端用户优惠券模块（需登录）---
@server(
    jwt:    JwtAuth
    group:  coupon
    prefix: api/v1/marketing/coupon
)
service shop-api {
    @doc "领券中心：获取全场可领取优惠券"
    @handler list
    get /list (CouponListReq) returns (CouponListResp)

    @doc "用户领取优惠券"
    @handler claim
    post /claim (ClaimCouponReq) returns (ClaimCouponResp)

    @doc "我的优惠券：查看个人卡券包"
    @handler myCoupons
    get /mine (MyCouponListReq) returns (MyCouponListResp)

    @doc "结算页：根据订单金额获取可用优惠券"
    @handler available
    post /available (AvailableCouponsReq) returns (AvailableCouponsResp)
}

// --- 内部接口（供订单服务调用，建议使用独立JWT或IP白名单）---
@server(
    jwt:    JwtAuth  // 使用相同鉴权，但只允许订单服务client_id
    group:  internal
    prefix: internal/v1/coupon
)
service shop-api {
    @doc "订单服务：使用优惠券（锁定并扣减）"
    @handler use
    post /use (UseCouponReq) returns (UseCouponResp)

    @doc "订单服务：解锁优惠券（订单取消时回滚）"
    @handler unlock
    post /unlock (UnlockCouponReq) returns (UnlockCouponResp)
}