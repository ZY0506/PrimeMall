syntax = "v1"

info (
	title:   "PrimeMall Admin API"
	desc:    "PrimeMall 管理后台"
	author:  "烤冷面"
	version: "v1.0"
)

// goctl api go -api ./apps/gateway/admin/admin.api -dir ./apps/gateway/admin
// goctl api plugin -plugin goctl-swagger="swagger -filename shop-admin.json" -api ./apps/gateway/admin/admin.api -dir ./doc/api
// =============================================================
// 公共类型
// =============================================================
type (
	IdReq {
		Id uint64 `path:"id"`
	}
	OrderSnReq {
		OrderSn string `path:"order_sn"`
	}
	Pagination {
		Page int64 `form:"page,default=1"`
		Size int64 `form:"size,default=10"`
	}
	UpdateStatusReq {
		Id     uint64 `json:"id"`
		Status int64  `json:"status"`
	}
)

// =============================================================
// 1. 认证模块 (auth)
// =============================================================
type (
	AdminLoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	AdminLoginResp {
		AccessToken  string `json:"access_token"`
		AccessExpire int64  `json:"access_expire"`
	}
)

// =============================================================
// 2. 管理员模块 (admin)
// =============================================================
type (
	ChangePasswordReq {
		OldPassword string `json:"old_password"`
		NewPassword string `json:"new_password"`
	}
	AdminInfoResp {
		Id       uint64 `json:"id"`
		Username string `json:"username"`
		Nickname string `json:"nickname"`
		Avatar   string `json:"avatar"`
		Role     string `json:"role"`
	}
	AdminOperateLogItem {
		Id        uint64 `json:"id"`
		AdminId   uint64 `json:"admin_id"`
		Module    string `json:"module"`
		Action    string `json:"action"`
		Content   string `json:"content"`
		Ip        string `json:"ip"`
		CreatedAt string `json:"created_at"`
	}
	AdminOperateLogResp {
		Total int64                 `json:"total"`
		List  []AdminOperateLogItem `json:"list"`
	}
)

// =============================================================
// 3. 用户管理模块 (user)
// =============================================================
type (
	AdminUserListReq {
		Pagination
		Keyword string `form:"keyword,optional"`
		Status  int64  `form:"status,optional"`
	}
	AdminUserItem {
		Id         uint64 `json:"id"`
		Phone      string `json:"phone"`
		Nickname   string `json:"nickname"`
		Avatar     string `json:"avatar"`
		Status     int64  `json:"status"`
		StatusDesc string `json:"status_desc"`
		CreatedAt  string `json:"created_at"`
	}
	AdminUserListResp {
		Total int64           `json:"total"`
		List  []AdminUserItem `json:"list"`
	}
	AdminUserDetailResp {
		Id            uint64 `json:"id"`
		Phone         string `json:"phone"`
		Nickname      string `json:"nickname"`
		Avatar        string `json:"avatar"`
		Gender        int64  `json:"gender"`
		Birthday      string `json:"birthday"`
		Status        int64  `json:"status"`
		StatusDesc    string `json:"status_desc"`
		OrderCount    int64  `json:"order_count"`
		TotalAmount   int64  `json:"total_amount"`
		LastLoginTime string `json:"last_login_time"`
		CreatedAt     string `json:"created_at"`
	}
	BlackUserReq {
		Id     uint64 `json:"id"`
		Reason string `json:"reason,optional"`
	}
	RecoverUserReq {
		Id uint64 `json:"id"`
	}
)

// =============================================================
// 4. 分类管理模块 (category)
// =============================================================
type (
	AdminCategoryItem {
		Id       uint64 `json:"id"`
		ParentId uint64 `json:"parent_id"`
		Name     string `json:"name"`
		Icon     string `json:"icon"`
		Level    int64  `json:"level"`
		Sort     int64  `json:"sort"`
	}
	CategoryListResp {
		List []AdminCategoryItem `json:"list"`
	}
	SaveCategoryReq {
		Id       uint64 `json:"id,optional"`
		ParentId uint64 `json:"parent_id"`
		Name     string `json:"name"`
		Icon     string `json:"icon,optional"`
		Sort     int64  `json:"sort"`
	}
)

// =============================================================
// 5. 商品管理模块 (product)
// =============================================================
type (
	ProductSpecItem {
		Name   string `json:"name"`
		Values string `json:"values"`
	}
	AdminSkuItem {
		Id       uint64            `json:"id,optional"`
		Code     string            `json:"code"`
		Pic      []string          `json:"pic"`
		Price    int64             `json:"price"`
		Stock    int64             `json:"stock"`
		Weight   int64             `json:"weight"`
		SpecData []ProductSpecItem `json:"spec_data"`
	}
	AdminProductListReq {
		Pagination
		Keyword    string `form:"keyword,optional"`
		CategoryId uint64 `form:"category_id,optional"`
		Status     int64  `form:"status,optional"`
	}
	AdminProductItem {
		Id         uint64 `json:"id"`
		Name       string `json:"name"`
		Brand      string `json:"brand"`
		DefaultPic string `json:"default_pic"`
		Price      int64  `json:"price"`
		Sales      int64  `json:"sales"`
		Status     int64  `json:"status"`
		CreatedAt  string `json:"created_at"`
	}
	AdminProductListResp {
		Total int64              `json:"total"`
		List  []AdminProductItem `json:"list"`
	}
	SaveProductReq {
		Id                uint64         `json:"id,optional"`
		CategoryId        uint64         `json:"category_id"`
		Brand             string         `json:"brand"`
		Name              string         `json:"name"`
		Description       string         `json:"description"`
		Content           string         `json:"content"`
		DefaultPic        string         `json:"default_pic"`
		BannerPics        []string       `json:"banner_pics"`
		VideoUrl          string         `json:"video_url,optional"`
		Weight            int64          `json:"weight"`
		FreightTemplateId uint64         `json:"freight_template_id"`
		Status            int64          `json:"status"`
		Skus              []AdminSkuItem `json:"skus"`
	}
	AdminProductDetailResp {
		Id                uint64         `json:"id"`
		CategoryId        uint64         `json:"category_id"`
		Brand             string         `json:"brand"`
		Name              string         `json:"name"`
		Description       string         `json:"description"`
		Price             int64          `json:"price"`
		Sales             int64          `json:"sales"`
		Content           string         `json:"content"`
		DefaultPic        string         `json:"default_pic"`
		BannerPics        []string       `json:"banner_pics"`
		VideoUrl          string         `json:"video_url"`
		Weight            int64          `json:"weight"`
		FreightTemplateId uint64         `json:"freight_template_id"`
		Status            int64          `json:"status"`
		Skus              []AdminSkuItem `json:"skus"`
		CreatedAt         string         `json:"created_at"`
	}
)

// =============================================================
// 6. 订单管理模块 (order)
// =============================================================
type (
	AdminOrderListReq {
		Pagination
		Status    int64  `form:"status,optional"`
		OrderSn   string `form:"order_sn,optional"`
		StartTime string `form:"start_time,optional"`
		EndTime   string `form:"end_time,optional"`
	}
	AdminOrderSnapshot {
		OrderSn    string `json:"order_sn"`
		UserId     uint64 `json:"user_id"`
		UserPhone  string `json:"user_phone"`
		PayAmount  int64  `json:"pay_amount"`
		Status     int64  `json:"status"`
		StatusDesc string `json:"status_desc"`
		CreatedAt  string `json:"created_at"`
	}
	AdminOrderListResp {
		Total int64                `json:"total"`
		List  []AdminOrderSnapshot `json:"list"`
	}
	AdminOrderItem {
		SkuId       uint64 `json:"sku_id"`
		SpuId       uint64 `json:"spu_id"`
		ProductName string `json:"product_name"`
		SkuName     string `json:"sku_name"`
		Pic         string `json:"pic"`
		Price       int64  `json:"price"`
		Quantity    int64  `json:"quantity"`
		TotalAmount int64  `json:"total_amount"`
	}
	AdminOrderAddress {
		ReceiverName  string `json:"receiver_name"`
		ReceiverPhone string `json:"receiver_phone"`
		Province      string `json:"province"`
		City          string `json:"city"`
		District      string `json:"district"`
		DetailAddress string `json:"detail_address"`
	}
	AdminOrderDetailResp {
		OrderSn       string            `json:"order_sn"`
		UserId        uint64            `json:"user_id"`
		UserPhone     string            `json:"user_phone"`
		Status        int64             `json:"status"`
		StatusDesc    string            `json:"status_desc"`
		PayType       int64             `json:"pay_type"`
		PayTypeDesc   string            `json:"pay_type_desc"`
		PayAmount     int64             `json:"pay_amount"`
		TotalAmount   int64             `json:"total_amount"`
		FreightAmount int64             `json:"freight_amount"`
		CouponAmount  int64             `json:"coupon_amount"`
		Remark        string            `json:"remark"`
		Address       AdminOrderAddress `json:"address"`
		Items         []AdminOrderItem  `json:"items"`
		DeliverySn    string            `json:"delivery_sn,optional"`
		DeliveryCorp  string            `json:"delivery_corp,optional"`
		PaymentSn     string            `json:"payment_sn,optional"`
		CreateTime    string            `json:"create_time"`
		PayTime       string            `json:"pay_time,optional"`
		DeliveryTime  string            `json:"delivery_time,optional"`
		FinishTime    string            `json:"finish_time,optional"`
		CancelTime    string            `json:"cancel_time,optional"`
	}
	ShipOrderReq {
		OrderSn      string `json:"order_sn"`
		DeliveryCorp string `json:"delivery_corp"`
		DeliverySn   string `json:"delivery_sn"`
		Remark       string `json:"remark,optional"`
	}
)

// =============================================================
// 7. 售后管理模块 (refund)
// =============================================================
type (
	AdminRefundListReq {
		Pagination
		Status int64 `form:"status,optional"`
	}
	AdminRefundItem {
		Id           uint64 `json:"id"`
		RefundSn     string `json:"refund_sn"`
		OrderSn      string `json:"order_sn"`
		UserId       uint64 `json:"user_id"`
		RefundAmount int64  `json:"refund_amount"`
		Status       int64  `json:"status"`
		StatusDesc   string `json:"status_desc"`
		CreatedAt    string `json:"created_at"`
	}
	AdminRefundListResp {
		Total int64             `json:"total"`
		List  []AdminRefundItem `json:"list"`
	}
	HandleRefundReq {
		RefundSn string `json:"refund_sn"`
		Action   int64  `json:"action"` // 1通过 2拒绝
		Remark   string `json:"remark,optional"`
	}
)

// =============================================================
// 8. 优惠券管理模块 (coupon)
// =============================================================
type (
	SaveCouponReq {
		Id                uint64 `json:"id,optional"`
		Name              string `json:"name"`
		Type              int64  `json:"type"`
		ThresholdAmount   int64  `json:"threshold_amount"`
		ReduceAmount      int64  `json:"reduce_amount"`
		DiscountRate      int64  `json:"discount_rate"`
		MaxDiscountAmount int64  `json:"max_discount_amount"`
		TotalQuantity     int64  `json:"total_quantity"`
		PerUserLimit      int64  `json:"per_user_limit"`
		StartTime         int64  `json:"start_time"`
		EndTime           int64  `json:"end_time"`
		Status            int64  `json:"status"`
		Description       string `json:"description"`
	}
	AdminCouponItem {
		Id            uint64 `json:"id"`
		Name          string `json:"name"`
		Type          int64  `json:"type"`
		TotalQuantity int64  `json:"total_quantity"`
		UsedQuantity  int64  `json:"used_quantity"`
		Status        int64  `json:"status"`
		StartTime     string `json:"start_time"`
		EndTime       string `json:"end_time"`
	}
	AdminCouponListReq {
		Pagination
		Status int64  `form:"status,optional"`
		Name   string `form:"name,optional"`
	}
	AdminCouponListResp {
		Total int64             `json:"total"`
		List  []AdminCouponItem `json:"list"`
	}
	AdminCouponDetailResp {
		Id                uint64 `json:"id"`
		Name              string `json:"name"`
		Type              int64  `json:"type"`
		ThresholdAmount   int64  `json:"threshold_amount"`
		ReduceAmount      int64  `json:"reduce_amount"`
		DiscountRate      int64  `json:"discount_rate"`
		MaxDiscountAmount int64  `json:"max_discount_amount"`
		TotalQuantity     int64  `json:"total_quantity"`
		UsedQuantity      int64  `json:"used_quantity"`
		PerUserLimit      int64  `json:"per_user_limit"`
		StartTime         int64  `json:"start_time"`
		EndTime           int64  `json:"end_time"`
		Status            int64  `json:"status"`
		Description       string `json:"description"`
		CreatedAt         int64  `json:"created_at"`
	}
)

// =============================================================
// 认证接口（无需JWT）
// =============================================================
@server (
	group:  auth
	prefix: /api/v1/admin
)
service admin {
	@doc "管理员登录"
	@handler login
	post /login (AdminLoginReq) returns (AdminLoginResp)
}

// =============================================================
// 管理员模块（需JWT）
// =============================================================
@server (
	jwt:    JwtAuth
	group:  admin
	prefix: /api/v1/admin
)
service admin {
	@doc "获取当前管理员信息"
	@handler adminInfo
	get /info returns (AdminInfoResp)

	@doc "修改密码"
	@handler changePassword
	put /password (ChangePasswordReq)

	@doc "操作日志"
	@handler operateLogs
	get /operate/logs (Pagination) returns (AdminOperateLogResp)
}

// =============================================================
// 用户管理模块（需JWT）
// =============================================================
@server (
	jwt:    JwtAuth
	group:  user
	prefix: /api/v1/admin/user
)
service admin {
	@doc "用户列表"
	@handler userList
	get /list (AdminUserListReq) returns (AdminUserListResp)

	@doc "用户详情"
	@handler userDetail
	get /detail/:id (IdReq) returns (AdminUserDetailResp)

	@doc "拉黑用户"
	@handler blacklistUser
	post /blacklist (BlackUserReq)

	@doc "恢复用户"
	@handler recoverUser
	put /recover (RecoverUserReq)
}

// =============================================================
// 分类管理模块（需JWT）
// =============================================================
@server (
	jwt:    JwtAuth
	group:  category
	prefix: /api/v1/admin/category
)
service admin {
	@doc "分类列表"
	@handler categoryList
	get /list returns (CategoryListResp)

	@doc "保存分类"
	@handler saveCategory
	post /save (SaveCategoryReq)

	@doc "删除分类"
	@handler deleteCategory
	delete /:id (IdReq)
}

// =============================================================
// 商品管理模块（需JWT）
// =============================================================
@server (
	jwt:    JwtAuth
	group:  product
	prefix: /api/v1/admin/product
)
service admin {
	@doc "商品列表"
	@handler productList
	get /list (AdminProductListReq) returns (AdminProductListResp)

	@doc "商品详情"
	@handler productDetail
	get /detail/:id (IdReq) returns (AdminProductDetailResp)

	@doc "保存商品"
	@handler saveProduct
	post /save (SaveProductReq)

	@doc "更新商品状态"
	@handler updateProductStatus
	post /status (UpdateStatusReq)

	@doc "删除商品"
	@handler deleteProduct
	delete /:id (IdReq)
}

// =============================================================
// 订单管理模块（需JWT）
// =============================================================
@server (
	jwt:    JwtAuth
	group:  order
	prefix: /api/v1/admin/order
)
service admin {
	@doc "订单列表"
	@handler orderList
	get /list (AdminOrderListReq) returns (AdminOrderListResp)

	@doc "订单详情"
	@handler orderDetail
	get /detail/:order_sn (OrderSnReq) returns (AdminOrderDetailResp)

	@doc "发货"
	@handler shipOrder
	post /ship (ShipOrderReq)
}

// =============================================================
// 售后管理模块（需JWT）
// =============================================================
@server (
	jwt:    JwtAuth
	group:  refund
	prefix: /api/v1/admin/refund
)
service admin {
	@doc "售后列表"
	@handler refundList
	get /list (AdminRefundListReq) returns (AdminRefundListResp)

	@doc "处理售后"
	@handler handleRefund
	post /handle (HandleRefundReq)
}

// =============================================================
// 优惠券管理模块（需JWT）
// =============================================================
@server (
	jwt:    JwtAuth
	group:  coupon
	prefix: /api/v1/admin/coupon
)
service admin {
	@doc "优惠券列表"
	@handler couponList
	get /list (AdminCouponListReq) returns (AdminCouponListResp)

	@doc "优惠券详情"
	@handler couponDetail
	get /detail/:id (IdReq) returns (AdminCouponDetailResp)

	@doc "保存优惠券"
	@handler saveCoupon
	post /save (SaveCouponReq)

	@doc "更新优惠券状态"
	@handler updateCouponStatus
	post /status (UpdateStatusReq)
}

