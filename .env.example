# =================================================================
# PrimeMall 环境配置文件
# 注意：正式环境请务必更换以下所有密码和密钥！
# =================================================================

# --- 1. MySQL 配置 ---
DB_HOST=
DB_PORT=your_port
DB_USER=
DB_PASSWORD=your_password

# --- 2. Redis 配置 (用于库存预扣减和缓存) ---
REDIS_HOST=
REDIS_PORT=your_port
REDIS_PASSWORD=your_password
REDIS_DB=

# --- 3. JWT 鉴权配置 (全局统一) ---
# 这里的 Secret 建议使用长随机字符串
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=your_jwt_expire
JWT_ISSUER=your_jwt_issuer

# --- 4. 第三方服务 (预留占位) ---
# 阿里云 OSS (用于商品图片上传)
OSS_ENDPOINT=
OSS_ACCESS_KEY=your_aliyun_key
OSS_ACCESS_SECRET=your_aliyun_secret
OSS_BUCKET=

# 支付接口 (微信/支付宝)
PAY_NOTIFY_URL=
