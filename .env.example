# =================================================================
# PrimeMall 环境配置文件模板
# 复制为 .env 并根据实际部署环境修改
# cp .env.example .env
# =================================================================

# =================================================================
# 1. MySQL 数据库配置
# 涉及服务: admin.rpc / marketing.rpc / order.rpc / payment.rpc
#           product.rpc / search.rpc / user.rpc
# docker-compose 中使用 ${DB_PORT:-13306}:3306
# =================================================================
DB_HOST=localhost
DB_PORT=13306
DB_USER=root
DB_PASSWORD=your_password


# =================================================================
# 2. Redis 缓存配置（用于库存预扣减、Session 缓存等）
# 涉及服务: shop-api / admin.rpc / marketing.rpc / order.rpc
#           payment.rpc / product.rpc / user.rpc
# docker-compose 中使用 ${REDIS_PORT:-16379}:6379
# =================================================================
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=your_redis_password


# =================================================================
# 3. Etcd 服务注册与发现
# 涉及服务: 全部网关和 RPC 服务
# docker-compose 中使用 ${ETCD_PORT:-12379}:2379
# =================================================================
ETCD_HOST=localhost
ETCD_PORT=12379


# =================================================================
# 4. RabbitMQ 消息队列（订单异步处理、支付回调通知）
# 涉及服务: order.rpc / payment.rpc
# RABBITMQ_PORT = AMQP 协议端口，RABBITMQ_UI_PORT = 管理控制台
# docker-compose 中使用 ${RABBITMQ_PORT:-5672}:5672
# =================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_UI_PORT=15672


# =================================================================
# 5. Elasticsearch 搜索引擎
# 涉及服务: search.rpc
# docker-compose 中使用 ${ES_PORT:-19200}:9200
# =================================================================
ES_HOST=localhost
ES_PORT=19200


# =================================================================
# 6. JWT 鉴权配置（全局统一）
# 涉及服务: shop-api / admin-api / user.rpc / admin.rpc
# Secret 建议使用 32 字节以上长随机字符串
# =================================================================
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7200
JWT_ISSUER=PrimeMall


# =================================================================
# 7. 阿里云 OSS（商品图片上传、用户头像等）
# 涉及服务: shop-api / user.rpc
# =================================================================
OSS_ENDPOINT=
OSS_ACCESS_KEY=your_aliyun_key
OSS_ACCESS_SECRET=your_aliyun_secret
OSS_BUCKET=
OSS_CALLBACK_URL=


# =================================================================
# 8. 支付回调通知 URL（预留）
# =================================================================
PAY_NOTIFY_URL=
