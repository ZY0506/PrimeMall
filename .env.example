# =================================================================
# PrimeMall 环境配置文件
# 注意：正式环境请务必更换以下所有密码和密钥！
# =================================================================

# --- 1. MySQL 配置 ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password

# --- 2. Redis 配置 (用于库存预扣减和缓存) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# --- 3. Etcd 配置 (服务注册与发现) ---
ETCD_HOST=localhost
ETCD_PORT=2379
ETCD_USERNAME=
ETCD_PASSWORD=

# --- 4. RabbitMQ 配置 (消息队列) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- 5. JWT 鉴权配置 (全局统一) ---
# 这里的 Secret 建议使用长随机字符串
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7200
JWT_ISSUER=PrimeMall

# --- 6. 第三方服务 (预留占位) ---
# 阿里云 OSS (用于商品图片上传)
OSS_ENDPOINT=
OSS_ACCESS_KEY=your_aliyun_key
OSS_ACCESS_SECRET=your_aliyun_secret
OSS_BUCKET=
OSS_CALLBACK_URL=

# 支付接口 (微信/支付宝)
PAY_NOTIFY_URL=

# --- Docker 外部端口映射 (可选) ---
DB_PORT_EXTERNAL=
REDIS_PORT_EXTERNAL=
ETCD_PORT_EXTERNAL=
RABBITMQ_PORT_EXTERNAL=
