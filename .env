# =================================================================
# PrimeMall 环境配置文件 (本地开发环境)
# 注意：正式环境请务必更换以下所有密码和密钥！
# =================================================================

# --- 1. MySQL 配置 ---
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=root
DB_PASSWORD=123456

# --- 2. Redis 配置 (用于库存预扣减和缓存) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=

# --- 3. JWT 鉴权配置 (全局统一) ---
JWT_SECRET=kaolengmian
JWT_ISSUER=kaolengmian

# --- 4. 第三方服务 (预留占位) ---
# 阿里云 OSS (用于商品图片上传)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY=your_aliyun_key
OSS_ACCESS_SECRET=your_aliyun_secret
OSS_BUCKET=primemall-assets

# OSS 回调地址（本地开发建议使用空值或内网穿透地址）
OSS_CALLBACK_URL=

# 支付接口 (微信/支付宝)
PAY_NOTIFY_URL=https://api.primemall.com/payment/callback
